import IndexedSourceWire

namespace IndexedSource

open LeanNCD.Semantics IndexedComponentComposition IndexedWitness

inductive Term : Object → Object → Type 1
  | identity (X : Object) : Term X X
  | wire {X Y : Object} (w : Wire X Y) : Term X Y
  | leaf {σ : Declarations Unit} [Fintype σ.Tensor] [DecidableEq σ.Tensor]
      (A : MatchedComponent σ) : Term (input A) (output A)
  | seq {X Y Z : Object} (f : Term X Y) (g : Term Y Z) : Term X Z

variable {σA σB σC : Declarations Unit}
variable [Fintype σA.Tensor] [DecidableEq σA.Tensor]
variable [Fintype σB.Tensor] [DecidableEq σB.Tensor]
variable [Fintype σC.Tensor] [DecidableEq σC.Tensor]

noncomputable def assembled (A : MatchedComponent σA) (B : MatchedComponent σB)
    (b : Boundary A B) : Term (input A) (output B) :=
  .seq (.wire (inputWire A B b))
    (.seq (.leaf (compose A B b)) (.wire (outputWire A B b)))

noncomputable def pair (A : MatchedComponent σA) (B : MatchedComponent σB)
    (b : Boundary A B) : Term (input A) (output B) :=
  .seq (.seq (.leaf A) (.wire (boundaryWire A B b))) (.leaf B)

noncomputable def triple (A : MatchedComponent σA) (B : MatchedComponent σB)
    (C : MatchedComponent σC) (ab : Boundary A B) (bc : Boundary B C) :
    Term (input A) (output C) :=
  .seq (pair A B ab) (.seq (.wire (boundaryWire B C bc)) (.leaf C))

noncomputable def leftNested (A : MatchedComponent σA) (B : MatchedComponent σB)
    (C : MatchedComponent σC) (ab : Boundary A B) (bc : Boundary B C) :
    Term (input A) (output C) :=
  .seq (.wire ((inputWire A B ab).comp
      (inputWire (compose A B ab) C (leftNestedBoundary A B C ab bc))))
    (.seq (.leaf (leftBracket A B C ab bc))
      (.wire (outputWire (compose A B ab) C (leftNestedBoundary A B C ab bc))))

noncomputable def rightNested (A : MatchedComponent σA) (B : MatchedComponent σB)
    (C : MatchedComponent σC) (ab : Boundary A B) (bc : Boundary B C) :
    Term (input A) (output C) :=
  .seq (.wire (inputWire A (compose B C bc) (rightNestedBoundary A B C ab bc)))
    (.seq (.leaf (rightBracket A B C ab bc))
      (.wire ((outputWire A (compose B C bc) (rightNestedBoundary A B C ab bc)).comp
        (outputWire B C bc))))

/-- The least typed congruence generated by categorical, coordinate-wire, and
    actual constructor equations. It is not equality of interpretations. -/
inductive Rel : {X Y : Object} → Term X Y → Term X Y → Prop
  | refl (f : Term X Y) : Rel f f
  | symm : Rel f g → Rel g f
  | trans : Rel f g → Rel g h → Rel f h
  | seq : Rel f f' → Rel g g' → Rel (.seq f g) (.seq f' g')
  | id_left (f : Term X Y) : Rel (.seq (.identity X) f) f
  | id_right (f : Term X Y) : Rel (.seq f (.identity Y)) f
  | assoc (f : Term W X) (g : Term X Y) (h : Term Y Z) :
      Rel (.seq (.seq f g) h) (.seq f (.seq g h))
  | wire_id (X : Object) : Rel (.wire (Wire.identity X)) (.identity X)
  | wire_comp (a : Wire X Y) (b : Wire Y Z) :
      Rel (.seq (.wire a) (.wire b)) (.wire (a.comp b))
  | wire_left_inv (a : Wire X Y) :
      Rel (.seq (.wire a) (.wire a.inverse)) (.identity X)
  | wire_right_inv (a : Wire X Y) :
      Rel (.seq (.wire a.inverse) (.wire a)) (.identity Y)
  | assembly {σA σB : Declarations Unit}
      [Fintype σA.Tensor] [DecidableEq σA.Tensor]
      [Fintype σB.Tensor] [DecidableEq σB.Tensor]
      (A : MatchedComponent σA) (B : MatchedComponent σB) (b : Boundary A B) :
      Rel (assembled A B b) (pair A B b)
  | left_square {σA σB σC : Declarations Unit}
      [Fintype σA.Tensor] [DecidableEq σA.Tensor]
      [Fintype σB.Tensor] [DecidableEq σB.Tensor]
      [Fintype σC.Tensor] [DecidableEq σC.Tensor]
      (A : MatchedComponent σA) (B : MatchedComponent σB)
      (C : MatchedComponent σC) (ab : Boundary A B) (bc : Boundary B C) :
      Rel (.wire (boundaryWire (compose A B ab) C (leftNestedBoundary A B C ab bc)))
        (.seq (.wire (outputWire A B ab)) (.wire (boundaryWire B C bc)))
  | right_square {σA σB σC : Declarations Unit}
      [Fintype σA.Tensor] [DecidableEq σA.Tensor]
      [Fintype σB.Tensor] [DecidableEq σB.Tensor]
      [Fintype σC.Tensor] [DecidableEq σC.Tensor]
      (A : MatchedComponent σA) (B : MatchedComponent σB)
      (C : MatchedComponent σC) (ab : Boundary A B) (bc : Boundary B C) :
      Rel (.wire (boundaryWire A (compose B C bc) (rightNestedBoundary A B C ab bc)))
        (.seq (.wire (boundaryWire A B ab)) (.wire (inputWire B C bc)))
  | bracket {σA σB σC : Declarations Unit}
      [Fintype σA.Tensor] [DecidableEq σA.Tensor]
      [Fintype σB.Tensor] [DecidableEq σB.Tensor]
      [Fintype σC.Tensor] [DecidableEq σC.Tensor]
      (A : MatchedComponent σA) (B : MatchedComponent σB)
      (C : MatchedComponent σC) (ab : Boundary A B) (bc : Boundary B C) :
      Rel (leftNested A B C ab bc) (rightNested A B C ab bc)

def termSetoid (X Y : Object) : Setoid (Term X Y) where
  r := Rel
  iseqv := ⟨Rel.refl, Rel.symm, Rel.trans⟩

end IndexedSource
