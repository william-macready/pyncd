def reverseEnvironment (X : WholeInterface) : X.Env ≃ X.Env :=
  Equiv.piCongrRight (fun t =>
    Equiv.arrowCongr
      (((canonicalLayout (X.signature t).axes).enumerate.symm.trans
        { toFun := Fin.rev, invFun := Fin.rev,
          left_inv := Fin.rev_rev, right_inv := Fin.rev_rev }).trans
          (canonicalLayout (X.signature t).axes).enumerate)
      (Equiv.refl ℚ))

