import EvalPlanCodegen
import Eval.Plan.KernelDenseTest

/-!
# Affine-table scaling probe — driver

One-off measurement for `papers/jax_evalplan_architecture.md` §7.6 row 2: how big is the generated
affine table for one mid-sized contraction, and how long does Lean take to render it? Renders
`Eval.Plan.KernelDenseTest.scalingProbePlan` (a 64x64, 4,096-coordinate `Y[i] := Σⱼ W[i,j]·x[j]`,
checked and Dense-verified in `Tests`, part of the default build) through the same
`EvalPlanCodegen.renderAffineAssign` path `EvalPlanAffineSmoke.lean`'s `buildAssignFixture` uses, in
the same one-fixture-per-entry `FIXTURES` module shape so `evalplan_affine_runtime.py` can run it
unchanged. Not a permanent test; run ad hoc via `lake env lean --run` and read the printed timing
plus the written file's byte size. Kept out of the default build, matching every other driver here.
-/

open LeanNCD LeanNCD.Eval LeanNCD.Eval.Plan Std
open JaxBridge Eval.Plan.KernelDenseTest

def main (args : List String) : IO Unit := do
  let outputPath := args.head?.getD "generated_scaling_probe.py"
  let t0 ← IO.monoMsNow
  let checked ← match checkAssign scalingProbeSigs scalingProbePlan with
    | .ok c => pure c
    | .error e => throw (IO.userError s!"scalingProbe check failed: {repr e}")
  let expected ← match runDenseAssign checked scalingProbeStore with
    | .ok d => pure d
    | .error e => throw (IO.userError s!"scalingProbe Dense run failed: {repr e}")
  let storeEntries := String.intercalate ", " (scalingProbeStore.toList.map pyTensorEntry)
  let fixture :=
    "{\"name\": " ++ pyStrLit "scalingProbe" ++ ", \"kind\": \"assign\", \"assign\": " ++
    renderAffineAssign checked ++ ", \"store\": [" ++ storeEntries ++ "], \"expected\": " ++
    pyTensorEntry expected ++ "}"
  let t1 ← IO.monoMsNow
  let moduleSrc :=
    "# Generated by ScalingProbe.lean — do not edit.\n" ++
    "FIXTURES = [\n" ++ fixture ++ "\n]\n"
  IO.FS.writeFile outputPath moduleSrc
  let bytes := moduleSrc.toUTF8.size
  IO.println s!"Generated {outputPath}: {bytes} bytes, render took {t1 - t0} ms"
