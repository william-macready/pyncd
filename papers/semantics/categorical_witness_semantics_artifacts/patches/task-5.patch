+@[reducible] def copyDeclarations (flipped : Bool) : Declarations Unit :=
+  ⟨Fin 2, fun t => (if flipped then 70 else 40) + t.val,
+    by
+      intro a b h
+      apply Fin.ext
+      change (if flipped then 70 else 40) + a.val =
+        (if flipped then 70 else 40) + b.val at h
+      omega,
+    fun _ => ⟨(), shape flipped⟩⟩
