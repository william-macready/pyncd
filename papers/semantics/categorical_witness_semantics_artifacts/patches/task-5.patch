+    · fin_cases s <;> rfl
+  eval_agrees := by
+    rintro ⟨⟨t, ht⟩, ⟨s, ⟨v, hv⟩⟩⟩ store
+    have he : v = 0 := Subsingleton.elim _ _
+    subst v
+    fin_cases t
+    · contradiction
+    · fin_cases s <;> rfl
+  priority := by cases flipped <;> rfl
