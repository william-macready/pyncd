+  sourceToWriter := copyOccurrenceEquiv flipped
+  writer_destination := by
+    rintro ⟨⟨t, ht⟩, ⟨s, ⟨v, hv⟩⟩⟩
+    have he : v = 0 := Subsingleton.elim _ _
+    subst v
