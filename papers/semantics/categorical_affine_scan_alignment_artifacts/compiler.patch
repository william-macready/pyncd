+/-- Clone `axisPosSched`, changing the recurrence expression and concrete extents only. -/
+def recurrenceSched (d n : Nat) (terms : List ProdTerm) (external : Bool := false) :
+    ScheduledProgram :=
+  { Prototype.spatialSched d n with
+    stmts := [.scan "S" [axL]
+      [.assign "S" [.free axJ, .iterAt axL 0]
+        { body := { terms := [{ factors := [.read "S0" [.axis axJ]] }] },
+          nonlin := .identity }]
+      [.assign "S" [.free axJ, .iterNext axL]
+        { body := { terms }, nonlin := .identity }]
+      false]
+    extNames := if external then insert "X" (insert "S0" (∅ : Finset String))
+      else insert "S0" (∅ : Finset String) }
+
+def vectorInputs : HashMap String DenseTensor :=
+  ({} : HashMap String DenseTensor).insert "S0" ⟨[4], #[2.0, 3.0, 5.0, 7.0]⟩
+
+def externalInputs : HashMap String DenseTensor :=
+  vectorInputs.insert "X" ⟨[9], #[11.0, 13.0, 17.0, 19.0, 23.0, 29.0, 31.0, 37.0, 41.0]⟩
+
+def stateFactor (spatial : IdxExpr) (time : IdxExpr := .axis axL) : Factor :=
+  .read "S" [spatial, time]
+
+def shiftSched := recurrenceSched 4 3 [{ factors := [stateFactor (.shift axJ (-1))] }]
+def strideSched := recurrenceSched 4 3 [{ factors := [stateFactor (.scale 2 axJ)] }]
+def reversalSched := recurrenceSched 4 3
+  [{ factors := [stateFactor (.affine 3 [(-1, axJ)])] }]
+
+def mixedState : Factor := stateFactor (.affine 0 [(1, axJ), (1, axL)])
+def mixedExternal : Factor := .read "X" [.affine 1 [(2, axJ), (1, axL)]]
+def mixedSched := recurrenceSched 4 3
+  [{ factors := [mixedState, mixedExternal, mixedState] },
+   { factors := [mixedExternal, mixedState] }] true
+
+/-- Spatial lift of `deepHistorySched`; the actual temporal source delta is still `l - 2`. -/
+def deepSched := recurrenceSched 4 3
+  [{ factors := [stateFactor (.axis axJ)] },
+   { factors := [stateFactor (.axis axJ) (.shift axL (-2))] }]
+
+/-- The certificate is obtained from the returned tables, not a normalized surrogate. -/
+structure CompiledExample (d n : Nat) where
+  scheduled : ScheduledProgram
+  signature : InputSignature
+  prepared : PreparedPlan
+  preparationOrigin : prepareEvalPlan scheduled signature = .ok prepared
+  raw : RawScanPlan
+  scanOrigin : scanAt prepared 0 = some raw
+  profile : Profile d n
+  certificationOrigin : certifyProfile prepared.plan.raw.tensorSigs raw d n = .ok profile
+
+def compileExample (sched : ScheduledProgram) (inputs : HashMap String DenseTensor)
+    (d n : Nat) : Except String (CompiledExample d n) := do
+  let scheduled := explicitF64Sched sched
+  let signature := InputSignature.ofDenseInputs inputs
+  match hp : prepareEvalPlan scheduled signature with
+  | .error e => .error (render e.cause)
+  | .ok prepared =>
+      match hs : scanAt prepared 0 with
+      | none => .error "step zero is not a scan"
+      | some raw =>
+          match hc : certifyProfile prepared.plan.raw.tensorSigs raw d n with
+          | .error e => .error s!"profile: {repr e}"
+          | .ok profile => .ok ⟨scheduled, signature, prepared, hp, raw, hs, profile, hc⟩
+
+def shiftExample := compileExample shiftSched vectorInputs 4 3
+def strideExample := compileExample strideSched vectorInputs 4 3
+def reversalExample := compileExample reversalSched vectorInputs 4 3
+def mixedExample := compileExample mixedSched externalInputs 4 3
+def deepExample := compileExample deepSched vectorInputs 4 3
+
+def shiftRaw := shiftExample.map (·.raw)
+def strideRaw := strideExample.map (·.raw)
+def reversalRaw := reversalExample.map (·.raw)
+def mixedRaw := mixedExample.map (·.raw)
+def deepRaw := deepExample.map (·.raw)
+def shiftProfile := shiftExample.map (·.profile)
+def strideProfile := strideExample.map (·.profile)
+def reversalProfile := reversalExample.map (·.profile)
+def mixedProfile := mixedExample.map (·.profile)
+def deepProfile := deepExample.map (·.profile)
+
+/-- Successful compilation carries an inhabited proof type, not a Boolean profile flag. -/
+theorem CompiledExample.profile_inhabited (e : CompiledExample d n) :
+    Nonempty (Profile d n) := ⟨e.profile⟩
+
+theorem CompiledExample.certified (e : CompiledExample d n) :
+    ∃ p : Profile d n,
+      certifyProfile e.prepared.plan.raw.tensorSigs e.raw d n = .ok p :=
+  ⟨e.profile, e.certificationOrigin⟩
+
+def actualTerms (p : Profile d n) : List TermPlan := (stepAssign p.checked).terms.toList
+
+def actualRead (p : Profile d n) (term factor : Nat) : ReadPlan :=
+  (((stepAssign p.checked).terms.getD term default).factors.getD factor default).readOrDefault
+
+def rawObservation (p : Profile d n) (term factor : Nat) (i clock : Int) : List Int :=
+  let t := (stepAssign p.checked).terms.getD term default
+  applyAffine (actualRead p term factor).map (termBasis t i clock)
+
+def coordValues {sh : Shape} (q : Coord sh) : List Nat :=
+  match sh with
+  | [] => []
+  | _ :: _ => q.1.val :: coordValues q.2
+
+def addressObservation (p : Profile d n) (a : Address (declarations p)) :
+    Bool × Nat × List Nat :=
+  match a with
+  | ⟨.inl slot, q⟩ => (false, slot.val, coordValues q)
+  | ⟨.inr _, q⟩ => (true, 0, coordValues q)
+
+/-- Nonconstant diagnostic store, not an executor or a claimed history model. -/
+def diagnosticStore (p : Profile d n) : Store RationalReference.Carrier (declarations p) :=
+  fun a =>
+    let (state, slot, coords) := addressObservation p a
+    let tag := if state then 100 else 1000 + 100 * slot
+    (tag + coords.foldl (fun acc x => 10 * acc + x) 0 : Nat)
+
+def stepBody (p : Profile d n) (i clock : Int) :=
+  orderedSum p p.checked.raw.stepCaptures (fun (_ : Unit) => i)
+    (fun _ => clock) (actualTerms p)
+
+def observedFootprint (p : Profile d n) (i clock : Int) :=
+  (footprint (stepBody p i clock) ()).map (addressObservation p)
+
+def observedValue (p : Profile d n) (i clock : Int) : Option ℚ :=
+  interpret RationalReference.ops (diagnosticStore p) (stepBody p i clock) ()
+
+def missingStepValue (p : Profile d n) (i clock : Int) : Option ℚ :=
+  evalWith RationalReference.ops (fun _ => none) (stepBody p i clock) ()
+
+def missingFactorValue (p : Profile d n) (term factor : Nat) (i clock : Int) : Option ℚ :=
+  let t := (stepAssign p.checked).terms.getD term default
+  evalWith RationalReference.ops (fun _ => none)
+    (factorBody p p.checked.raw.stepCaptures (fun (_ : Unit) => termBasis t i clock)
+      (t.factors.getD factor default)) ()
+
+def mapStepReads (raw : RawScanPlan) (f : ReadPlan → ReadPlan) : RawScanPlan :=
+  { raw with stepBlock := { raw.stepBlock with
+    steps := raw.stepBlock.steps.map fun
+      | .assign a => .assign { a with terms := a.terms.map fun t =>
+          { t with factors := t.factors.map fun
+            | .read r => .read (f r)
+            | x => x } }
+      | x => x } }
+
+/-- Swap the unequal external-row columns, retaining the actual slot, shape and bias. -/
+def wrongBasisRaw (e : CompiledExample 4 3) : RawScanPlan :=
+  mapStepReads e.raw fun r =>
+    if r.sourceShape.size == 1 then
+      { r with map := { r.map with coeffs := r.map.coeffs.map fun row =>
+          #[row.getD 1 0, row.getD 0 0] } }
+    else r
+
+/-- Drop the spatial column in the mixed state row; the temporal row remains causal. -/
+def wrongMapRaw (e : CompiledExample 4 3) : RawScanPlan :=
+  mapStepReads e.raw fun r =>
+    if r.sourceShape.size == 2 then
+      { r with map := { r.map with coeffs := r.map.coeffs.modify 0 fun row => row.set! 1 0 } }
+    else r
+
+def certifyMutation (e : CompiledExample d n) (raw : RawScanPlan) :
+    Except String (Profile d n) :=
+  (certifyProfile e.prepared.plan.raw.tensorSigs raw d n).mapError (fun e => s!"{repr e}")
+
+def wrongBasisExample : Except String (Profile 4 3) := do
+  let e ← mixedExample
+  certifyMutation e (wrongBasisRaw e)
+
+def wrongMapExample : Except String (Profile 4 3) := do
+  let e ← mixedExample
+  certifyMutation e (wrongMapRaw e)
+
+def wrongOrderRaw (e : CompiledExample 4 3) : RawScanPlan :=
+  { e.raw with stepBlock := { e.raw.stepBlock with steps := e.raw.stepBlock.steps.map fun
+    | .assign a => .assign { a with terms := a.terms.map fun t =>
+        { t with factors := t.factors.set! 0 (t.factors.getD 1 default)
+            |>.set! 1 (t.factors.getD 0 default) } }
+    | x => x } }
+
+def wrongMultiplicityRaw (e : CompiledExample 4 3) : RawScanPlan :=
+  { e.raw with stepBlock := { e.raw.stepBlock with steps := e.raw.stepBlock.steps.map fun
+    | .assign a => .assign { a with terms := a.terms.modify 0 fun t =>
+        { t with factors := t.factors.pop } }
+    | x => x } }
+
+def wrongOrderExample : Except String (Profile 4 3) := do
+  let e ← mixedExample
+  certifyMutation e (wrongOrderRaw e)
+
+def wrongMultiplicityExample : Except String (Profile 4 3) := do
+  let e ← mixedExample
+  certifyMutation e (wrongMultiplicityRaw e)
+
+def controlObservations (p : Profile 4 3) :=
+  (rawObservation p 0 0 1 2, rawObservation p 0 1 1 2,
+    observedFootprint p 1 2, observedValue p 1 2)
+
+def controlFailureReports : Except String (List String) := do
+  let e ← mixedExample
+  let basis ← wrongBasisExample
+  let map ← wrongMapExample
+  let order ← wrongOrderExample
+  let multiplicity ← wrongMultiplicityExample
+  let mut failures := []
+  for (name, p) in [("wrong basis columns", basis), ("wrong spatial map", map),
+      ("wrong factor order", order), ("wrong multiplicity", multiplicity)] do
+    match expectEq name (observedFootprint p 1 2) (observedFootprint e.profile 1 2) with
+    | .ok _ => .error s!"{name}: negative control failed to distinguish the access error"
+    | .error message => failures := failures ++ [message]
+  pure failures
+
+def temporalSched (time : IdxExpr) :=
+  recurrenceSched 4 3 [{ factors := [stateFactor (.axis axJ) time] }]
+
+def sourceRejection (time : IdxExpr) : Option String :=
+  (causeOf (prepareEvalPlan (explicitF64Sched (temporalSched time))
+    (InputSignature.ofDenseInputs vectorInputs))).map render
+
+/-- ScanTest's checker deltas, applied to actual compiler-produced deep-history tables. -/
+def badTemporalRaw (e : CompiledExample 4 3) (row : Array Int) (offset : Int) : RawScanPlan :=
+  mapStepReads e.raw fun r =>
+    { r with map :=
+      { r.map with
+        coeffs := r.map.coeffs.set! 1 row
+        «bias» := r.map.bias.set! 1 offset } }
+
+def checkerRejection (row : Array Int) (offset : Int) : Except String String := do
+  let e ← deepExample
+  match certifyProfile e.prepared.plan.raw.tensorSigs (badTemporalRaw e row offset) 4 3 with
+  | .error (.checker err) => .ok s!"{repr err}"
+  | .error .unsupported => .error "profile refusal bypassed the unchanged checker"
+  | .ok _ => .error "noncausal control was accepted"
+
+def spatialObservations (e : CompiledExample 4 3) :=
+  (List.range 4).map fun i =>
+    (rawObservation e.profile 0 0 i 0, observedFootprint e.profile i 0,
+      observedValue e.profile i 0)
+
+def historyObservation (e : CompiledExample d n) (inputs : HashMap String DenseTensor) :
+    Except String (List Nat × Array Float) := do
+  let report ← (runPreparedDense e.prepared inputs).mapError (fun err => s!"{repr err.cause}")
+  let some history := report.env["S"]? | .error "missing materialized S"
+  pure (history.shape, history.data)
+
+#eval shiftExample.map spatialObservations
+#eval strideExample.map spatialObservations
+#eval reversalExample.map spatialObservations
+#eval mixedExample.map fun e =>
+  (e.prepared.plan.raw.tensorSigs, e.raw.stepCaptures,
+    (stepAssign e.profile.checked).terms.map fun t =>
+      (t.iterationShape, t.contextPos, t.outputPos, t.factors.map (·.readOrDefault)))
+#eval mixedExample.map fun e =>
+  (rawObservation e.profile 0 0 1 2, rawObservation e.profile 0 1 1 2,
+    observedFootprint e.profile 1 2, observedValue e.profile 1 2)
+#eval deepExample.map fun e => (List.range 3).map fun t =>
+  (rawObservation e.profile 1 0 1 t, observedFootprint e.profile 1 t,
+    observedValue e.profile 1 t)
+#eval wrongBasisExample.map controlObservations
+#eval wrongMapExample.map controlObservations
+#eval wrongOrderExample.map controlObservations
+#eval wrongMultiplicityExample.map controlObservations
+#eval [sourceRejection (.shift axL 1), sourceRejection (.scale 2 axL),
+  sourceRejection (.axis axJ)]
+#eval [checkerRejection #[1, 0] 1, checkerRejection #[2, 0] 0,
+  checkerRejection #[0, 1] 0]
+#eval (compileExample (temporalSched (.shift axL (-1))) vectorInputs 4 3).map
+  fun e => (rawObservation e.profile 0 0 1 2, observedFootprint e.profile 1 2,
+    observedValue e.profile 1 2)
+#eval shiftExample.bind (fun e => historyObservation e vectorInputs)
+#eval strideExample.bind (fun e => historyObservation e vectorInputs)
+#eval reversalExample.bind (fun e => historyObservation e vectorInputs)
+#eval mixedExample.bind (fun e => historyObservation e externalInputs)
+#eval deepExample.bind (fun e => historyObservation e vectorInputs)
+#eval shiftExample.map fun e =>
+  ((actualRead e.profile 0 0).map, e.raw.stepCaptures, e.raw.stepWrites)
+#eval strideExample.map fun e => (actualRead e.profile 0 0).map
+#eval reversalExample.map fun e => (actualRead e.profile 0 0).map
+#eval deepExample.map fun e => (actualRead e.profile 1 0).map
+#eval mixedExample.map fun e =>
+  (controlObservations e.profile,
+    observedFootprint e.profile 2 2, observedValue e.profile 2 2, missingStepValue e.profile 2 2,
+    observedFootprint e.profile 3 2, observedValue e.profile 3 2, missingStepValue e.profile 3 2)
+#eval deepExample.map fun e =>
+  (missingFactorValue e.profile 1 0 1 0, missingFactorValue e.profile 1 0 1 1,
+    missingFactorValue e.profile 1 0 1 2)
+#eval controlFailureReports
+
+def checkLinks (e : CompiledExample 4 3) : Except String Unit := do
+  expectEq "actual compiler raw retained" e.profile.checked.raw e.raw
+  expectEq "actual outer signatures retained" e.profile.checked.sigs e.prepared.plan.raw.tensorSigs
+  expectEq "history extents" e.raw.historyExtents #[4]
+  expectEq "checked recurrence extents" e.profile.checked.stepExtents #[3]
+  expectEq "history signature"
+    e.prepared.plan.raw.tensorSigs[(e.raw.states.getD 0 default).destSlot]?
+    (some { shape := #[4, 4], dtype := .f64 })
+  expectEq "base capture" e.raw.baseCaptures #[{ inputSlot := 0, source := .external 0 }]
+  expectEq "base signature" e.prepared.plan.raw.tensorSigs[0]?
+    (some { shape := #[4], dtype := .f64 })
+  expectEq "canonical base write" e.raw.baseWrites
+    #[{ outputSlot := 1, stateIndex := 0,
+        map := { coeffs := #[#[1], #[0]], «bias» := #[0, 0] } }]
+  expectEq "canonical successor write" (e.raw.stepWrites.getD 0 default).map
+    { coeffs := #[#[0, 1], #[1, 0]], «bias» := #[0, 1] }
+
+def checkSpatialFamily : Except String Unit := do
+  let shift ← shiftExample
+  let stride ← strideExample
+  let reversal ← reversalExample
+  for e in [shift, stride, reversal] do
+    checkLinks e
+    expectEq "single immutable state capture" e.raw.stepCaptures
+      #[{ inputSlot := 0, source := .state 0 }]
+  expectEq "compiled shift map" (actualRead shift.profile 0 0).map
+    { coeffs := #[#[0, 1], #[1, 0]], «bias» := #[-1, 0] }
+  expectEq "compiled stride map" (actualRead stride.profile 0 0).map
+    { coeffs := #[#[0, 2], #[1, 0]], «bias» := #[0, 0] }
+  expectEq "compiled reversal map" (actualRead reversal.profile 0 0).map
+    { coeffs := #[#[0, -1], #[1, 0]], «bias» := #[3, 0] }
+  expectEq "shift address/padding/value observations" (spatialObservations shift)
+    [([-1, 0], [], some 0),
+     ([0, 0], [(true, 0, [0, 0])], some 100),
+     ([1, 0], [(true, 0, [1, 0])], some 110),
+     ([2, 0], [(true, 0, [2, 0])], some 120)]
+  expectEq "stride address/padding/value observations" (spatialObservations stride)
+    [([0, 0], [(true, 0, [0, 0])], some 100),
+     ([2, 0], [(true, 0, [2, 0])], some 120),
+     ([4, 0], [], some 0), ([6, 0], [], some 0)]
+  expectEq "reversal address/value observations" (spatialObservations reversal)
+    [([3, 0], [(true, 0, [3, 0])], some 130),
+     ([2, 0], [(true, 0, [2, 0])], some 120),
+     ([1, 0], [(true, 0, [1, 0])], some 110),
+     ([0, 0], [(true, 0, [0, 0])], some 100)]
+  expectEq "shift dense history" (← historyObservation shift vectorInputs)
+    ([4, 4], #[2.0, 0.0, 0.0, 0.0, 3.0, 2.0, 0.0, 0.0,
+      5.0, 3.0, 2.0, 0.0, 7.0, 5.0, 3.0, 2.0])
+  expectEq "stride dense history" (← historyObservation stride vectorInputs)
+    ([4, 4], #[2.0, 2.0, 2.0, 2.0, 3.0, 5.0, 0.0, 0.0,
+      5.0, 0.0, 0.0, 0.0, 7.0, 0.0, 0.0, 0.0])
+  expectEq "reversal dense history" (← historyObservation reversal vectorInputs)
+    ([4, 4], #[2.0, 7.0, 2.0, 7.0, 3.0, 5.0, 3.0, 5.0,
+      5.0, 3.0, 5.0, 3.0, 7.0, 2.0, 7.0, 2.0])
+
+def checkMixedFamily : Except String Unit := do
+  let e ← mixedExample
+  let basis ← wrongBasisExample
+  let map ← wrongMapExample
+  let order ← wrongOrderExample
+  let multiplicity ← wrongMultiplicityExample
+  let _ ← controlFailureReports
+  checkLinks e
+  expectEq "mixed actual captures" e.raw.stepCaptures
+    #[{ inputSlot := 0, source := .state 0 }, { inputSlot := 1, source := .external 1 }]
+  expectEq "distinct external source shape" e.prepared.plan.raw.tensorSigs[1]?
+    (some { shape := #[9], dtype := .f64 })
+  expectEq "actual mixed state map" (actualRead e.profile 0 0).map
+    { coeffs := #[#[1, 1], #[1, 0]], «bias» := #[0, 0] }
+  expectEq "actual unequal external coefficients" (actualRead e.profile 0 1).map
+    { coeffs := #[#[1, 2]], «bias» := #[1] }
+  expectEq "actual basis positions"
+    ((stepAssign e.profile.checked).terms.map fun t =>
+      (t.iterationShape, t.contextPos, t.outputPos))
+    #[(#[3, 4], #[0], #[1]), (#[3, 4], #[0], #[1])]
+  expectEq "actual factor order/multiplicity"
+    ((stepAssign e.profile.checked).terms.map fun t => t.factors.map (·.readOrDefault.sourceSlot))
+    #[#[0, 1, 0], #[1, 0]]
+  expectEq "mixed actual observations" (controlObservations e.profile)
+    ([3, 2], [5],
+      [(true, 0, [3, 2]), (false, 1, [5]), (true, 0, [3, 2]),
+       (false, 1, [5]), (true, 0, [3, 2])], some 19399380)
+  expectEq "wrong basis columns distinguished" (controlObservations basis)
+    ([3, 2], [6],
+      [(true, 0, [3, 2]), (false, 1, [6]), (true, 0, [3, 2]),
+       (false, 1, [6]), (true, 0, [3, 2])], some 19416936)
+  expectEq "wrong spatial map distinguished" (controlObservations map)
+    ([2, 2], [5],
+      [(true, 0, [2, 2]), (false, 1, [5]), (true, 0, [2, 2]),
+       (false, 1, [5]), (true, 0, [2, 2])], some 16581630)
+  expectEq "wrong factor order distinguished by footprint" (controlObservations order)
+    ([5], [3, 2],
+      [(false, 1, [5]), (true, 0, [3, 2]), (true, 0, [3, 2]),
+       (true, 0, [3, 2]), (false, 1, [5])], some 19399380)
+  expectEq "wrong multiplicity distinguished" (controlObservations multiplicity)
+    ([3, 2], [5],
+      [(true, 0, [3, 2]), (false, 1, [5]), (false, 1, [5]),
+       (true, 0, [3, 2])], some 291720)
+  expectEq "padded state reads remove only their own dependencies"
+    (observedFootprint e.profile 2 2, observedValue e.profile 2 2,
+      missingStepValue e.profile 2 2)
+    ([(false, 1, [7]), (false, 1, [7])], some 0, none)
+  expectEq "all padded reads are constants, not unavailable reads"
+    (observedFootprint e.profile 3 2, observedValue e.profile 3 2,
+      missingStepValue e.profile 3 2)
+    ([], some 0, some 0)
+  expectEq "mixed dense history (runtime Float observation only)"
+    (← historyObservation e externalInputs)
+    ([4, 4], #[2.0, 78.0, 887604.0, 336864385472887616.0,
+      3.0, 228.0, 17428710.0, 0.0, 5.0, 870.0, 133152936.0, 0.0,
+      7.0, 2072.0, 0.0, 0.0])
+
+def checkDeepFamily : Except String Unit := do
+  let e ← deepExample
+  let neighbor ← compileExample (temporalSched (.shift axL (-1))) vectorInputs 4 3
+  let immediate ← compileExample (temporalSched (.axis axL)) vectorInputs 4 3
+  checkLinks e
+  checkLinks neighbor
+  checkLinks immediate
+  expectEq "deep actual history map" (actualRead e.profile 1 0).map
+    { coeffs := #[#[0, 1], #[1, 0]], «bias» := #[0, -2] }
+  expectEq "deep negative-time padding and legal history access"
+    ((List.range 3).map fun t =>
+      (rawObservation e.profile 1 0 1 t, observedFootprint e.profile 1 t,
+        observedValue e.profile 1 t))
+    [([1, -2], [(true, 0, [1, 0])], some 110),
+     ([1, -1], [(true, 0, [1, 1])], some 111),
+     ([1, 0], [(true, 0, [1, 2]), (true, 0, [1, 0])], some 222)]
+  expectEq "legal lookback neighbor"
+    (rawObservation neighbor.profile 0 0 1 2, observedFootprint neighbor.profile 1 2,
+      observedValue neighbor.profile 1 2)
+    ([1, 1], [(true, 0, [1, 1])], some 111)
+  expectEq "padded deep factors succeed without a store, in-bounds factors do not"
+    (missingFactorValue e.profile 1 0 1 0, missingFactorValue e.profile 1 0 1 1,
+      missingFactorValue e.profile 1 0 1 2)
+    (some 0, some 0, none)
+  for time in [.shift axL 1, .scale 2 axL, .axis axJ] do
+    expectEq "source causality boundary" (sourceRejection time)
+      (some "scan: LeanNCD.Eval.Plan.ScanCompileError.stateReadNotCausal \"S\" \"S\" 0 0 0")
+  for (row, offset) in [(#[1, 0], 1), (#[2, 0], 0), (#[0, 1], 0)] do
+    expectEq "profile refusal must be the unchanged checker failure"
+      (← checkerRejection row offset) "LeanNCD.Eval.Plan.ScanPlanError.causalityFailure 0 0 0 0"
+  expectEq "deep dense history" (← historyObservation e vectorInputs)
