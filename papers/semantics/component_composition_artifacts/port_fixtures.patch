+      left_inv := by
+        rintro ⟨t, ht⟩
+        change (t == 0) = true at ht
+        fin_cases t <;> first | rfl | exact False.elim (Bool.noConfusion ht)
+      right_inv := by intro t; apply Subtype.ext; exact Subsingleton.elim _ _ }
+  domain := fun _ => Domain.id []
