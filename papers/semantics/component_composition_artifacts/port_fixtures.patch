+  keys := [.publication ⟨producerPre, rfl⟩ ()]
+  keys_nodup := by simp
+  keys_complete := by
+    intro k
+    cases k with
+    | occurrence t o => exact Fin.elim0 o.1
+    | publication t p =>
+      rcases t with ⟨t, ht⟩
+      fin_cases t
+      cases p
+      simp [producerPre]
