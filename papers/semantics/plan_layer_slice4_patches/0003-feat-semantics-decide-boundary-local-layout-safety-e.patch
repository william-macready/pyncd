+theorem checkLayoutAt_iff (pc : Nat) : π.checkLayoutAt pc = true ↔ π.LayoutOK pc := by
+  simp only [checkLayoutAt, List.all_eq_true, decide_eq_true_eq]
+  constructor
+  · intro h a b ξ ha hb
+    exact h a (π.mem_resourceList a) b (π.mem_resourceList b)
