+namespace SharedSplice
+
+variable {S E F : Type*}
+abbrev H (S E F : Type*) := History S E F Unit
+
+/-- `none` is usable on failure without constructing any continuation or output. -/
+inductive Splice : H S E F → Option (H S E F) → H S E F → Prop
+  | done (s : S) (suffix : H S E F) (shared : suffix.start = s) :
+      Splice (.done s ()) (some suffix) suffix
+  | failed (s : S) (event : E) (failure : F) (suffix : Option (H S E F)) :
+      Splice (.failed s event failure) suffix (.failed s event failure)
+  | step (s : S) (event : E) {h suffix result} (tail : Splice h suffix result) :
+      Splice (.step s event h) suffix (.step s event result)
+
+def append (h k : H S E F) : H S E F := h.bind (fun _ _ => k)
+
+theorem start {h result : H S E F} {suffix} (joined : Splice h suffix result) :
+    result.start = h.start := by
+  cases joined with
+  | done _ _ shared => exact shared
+  | failed | step => rfl
+
+theorem success (h k : H S E F) {s}
+    (finished : h.finish = .ok (s, ())) (shared : k.start = s) :
+    Splice h (some k) (append h k) := by
+  induction h with
+  | done x a =>
+      cases a
+      simp only [History.finish, Except.ok.injEq, Prod.mk.injEq] at finished
+      rcases finished with ⟨rfl, _⟩
+      exact .done _ _ shared
+  | failed => cases finished
+  | step x e tail ih => exact .step x e (ih finished)
+
+theorem failure (h : H S E F) {s f} (finished : h.finish = .error (s, f)) :
+    Splice h none h := by
+  induction h with
+  | done => cases finished
+  | failed => exact .failed _ _ _ _
+  | step x e tail ih => exact .step x e (ih finished)
+
+theorem canonical {h k result : H S E F} (joined : Splice h (some k) result) :
+    result = append h k := by
+  induction h generalizing result with
+  | done s a => cases a; cases joined; rfl
+  | failed => cases joined; rfl
+  | step s e tail ih =>
+      cases joined
+      congr 1
+      apply ih
+      assumption
+
+theorem unique {h result other : H S E F} {suffix}
+    (left : Splice h suffix result) (right : Splice h suffix other) : result = other := by
+  induction left generalizing other with
+  | done => cases right; rfl
+  | failed => cases right; rfl
+  | step _ _ _ ih =>
+      cases right
+      congr 1
+      apply ih
+      assumption
+
+theorem associative {a b c ab bc : H S E F}
+    (first : Splice a (some b) ab) (second : Splice b (some c) bc) :
+    ∃ result, Splice ab (some c) result ∧ Splice a (some bc) result := by
+  induction a generalizing ab with
+  | done s a =>
+      cases a
+      cases first with
+      | done _ _ shared =>
+          exact ⟨bc, second, .done s bc ((start second).trans shared)⟩
+  | failed s e f =>
+      cases first
+      exact ⟨.failed s e f, .failed _ _ _ _, .failed _ _ _ _⟩
+  | step s e tail ih =>
+      cases first
+      obtain ⟨result, left, right⟩ := ih (by assumption)
+      exact ⟨.step s e result, .step _ _ left, .step _ _ right⟩
+
+theorem associative_eq {a b c ab bc left right : H S E F}
+    (first : Splice a (some b) ab) (second : Splice b (some c) bc)
+    (leftJoin : Splice ab (some c) left) (rightJoin : Splice a (some bc) right) :
+    left = right := by
+  obtain ⟨result, hl, hr⟩ := associative first second
+  exact (unique leftJoin hl).trans (unique rightJoin hr).symm
+
+theorem transport {T D G : Type*} (s : S → T) (e : E → D) (f : F → G)
+    {h result : H S E F} {suffix} (joined : Splice h suffix result) :
+    Splice (h.map s e f id) (suffix.map (History.map s e f id))
+      (result.map s e f id) := by
+  induction joined with
+  | done x k shared =>
+      exact .done _ _ (by simpa using congrArg s shared)
+  | failed => exact .failed _ _ _ _
+  | step _ _ _ ih => exact .step _ _ ih
+
+theorem cut (h k : H S E F) {s} (finished : h.finish = .ok (s, ())) :
+    ∃ pre, h.states = pre ++ [s] ∧
+      (append h k).states = pre ++ k.states ∧
+      (append h k).events = h.events ++ k.events ∧
+      (append h k).finish = k.finish := by
+  induction h with
+  | done x a =>
+      cases a
+      simp only [History.finish, Except.ok.injEq, Prod.mk.injEq] at finished
+      rcases finished with ⟨rfl, _⟩
+      exact ⟨[], rfl, rfl, rfl, rfl⟩
+  | failed => cases finished
+  | step x e tail ih =>
+      obtain ⟨pre, hp, hs, he, hf⟩ := ih finished
+      exact ⟨x :: pre, congrArg (List.cons x) hp,
+        congrArg (List.cons x) hs, congrArg (List.cons e) he, hf⟩
+
+end SharedSplice
+
+open LeanNCD.Semantics LeanNCD.Semantics.Program
+open IndexedOpenComposition IndexedComponentComposition IndexedComponentTransport
+open IndexedComponentExecution
