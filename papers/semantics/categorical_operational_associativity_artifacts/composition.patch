+structure Cut {S : Type*} (states : List S) where
+  before : List S
+  current : S
+  after : List S
+  exact_states : states = before ++ current :: after
+
+structure CutRelated {S T : Type*} (R : S → T → Prop)
+    {xs : List S} {ys : List T} (a : Cut xs) (b : Cut ys) : Prop where
