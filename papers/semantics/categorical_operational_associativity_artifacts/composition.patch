+theorem up_append {σ τ : Declarations Unit}
+    [Fintype σ.Tensor] [DecidableEq σ.Tensor] [Fintype τ.Tensor] [DecidableEq τ.Tensor]
+    (X : MatchedComponent σ) (Y : MatchedComponent τ) (h k : GraphHistory σ) :
