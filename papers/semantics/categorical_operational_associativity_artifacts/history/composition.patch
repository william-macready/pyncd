+example : Splice first (some (second.run 1 ())) (append first (second.run 1 ())) :=
+  success _ _ rfl rfl
+
+example : Splice privateFailure none privateFailure :=
+  failure _ rfl
+
+example : Splice (.done 1 () : H Nat Nat Nat)
