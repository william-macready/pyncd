+++ b/leanncd/experiments/indexed_execution/IndexedComponentExecutionFuel.lean
@@ -0,0 +1,82 @@
+import IndexedCompositionValidated
+
+namespace IndexedComponentExecution
+
+open LeanNCD.Semantics
+open LeanNCD.Semantics.Program
+open IndexedOpenComposition
+
+variable {σ : Declarations Unit} [Fintype σ.Tensor] [DecidableEq σ.Tensor]
+
+theorem stepFuel_add_of_not_exhausted (steps : List (Step σ)) (fuel extra : Nat)
+    (state : State σ)
+    (terminal : ∀ endpoint, (stepFuel steps fuel state).outcome ≠ .exhausted endpoint) :
+    stepFuel steps (fuel + extra) state = stepFuel steps fuel state := by
+  induction fuel generalizing state with
+  | zero =>
+      rw [stepFuel] at terminal
+      conv_lhs => rw [stepFuel]
+      conv_rhs => rw [stepFuel]
+      by_cases hc : complete steps state = true
+      · simp [hc]
+      · simp only [hc, ↓reduceIte] at terminal ⊢
+        cases hs : steps.find? (enabled state) with
+        | none => simp [hs]
+        | some step => simp [hs] at terminal
+  | succ fuel ih =>
+      rw [stepFuel] at terminal
+      conv_lhs => rw [stepFuel]
+      conv_rhs => rw [stepFuel]
+      by_cases hc : complete steps state = true
+      · simp [hc]
+      · simp only [hc, ↓reduceIte, Nat.succ_add] at terminal ⊢
+        cases hs : steps.find? (enabled state) with
+        | none => simp [hs]
+        | some step =>
+            cases step with
+            | write w =>
+                simp only [hs]
+                cases he : evalReady RationalReference.ops state.available w.body () with
+                | notReady => rfl
+                | evaluated result =>
+                    cases result with
+                    | none => rfl
+                    | some value =>
+                        simp only
+                        rw [ih _ (by simpa [hs, he] using terminal)]
+            | collect a caps =>
+                simp only [hs]
+                cases hv : caps.mapM (producedValue state) with
+                | none => rfl
+                | some values =>
+                    simp only
+                    rw [ih _ (by simpa [hs, hv] using terminal)]
+
+theorem stepFuel_eq_of_enough (steps : List (Step σ)) (small large : Nat)
+    (state : State σ) (enough : Correspondence.remaining steps state < small)
+    (le : small ≤ large) :
+    stepFuel steps large state = stepFuel steps small state := by
+  obtain ⟨extra, rfl⟩ := Nat.exists_eq_add_of_le le
+  exact stepFuel_add_of_not_exhausted steps small extra state
+    (Correspondence.stepFuel_not_exhausted steps small state enough)
+
+theorem checked_eq_stepFuel
+    {P : Program RationalReference.Carrier σ RationalReference.registry}
+    {schedule : Executor.Schedule P} {contract : Contract σ} {fragment : Fragment σ}
+    {graph : Closed σ} (M : SourceContractMatch P schedule contract fragment graph)
+    (η : P.Input) :
+    runChecked contract fragment η.val =
+      stepFuel graph.steps (graph.steps.length + 1) (initial η.val) := by
+  simp only [runChecked, M.close_ok]
+  unfold execute
+  have valid : graph.contract.tensors.find?
+      (fun t => (η.val t).isSome != graph.contract.input t) = none := by
+    apply List.find?_eq_none.mpr
+    intro t _
+    have hc := (close_success_canonical M.close_ok).1
+    have ht := η.property t
+    change (η.val t).isSome = P.input t at ht
+    simp [hc, M.input_roles, ht]
+  simp [valid]
+
+end IndexedComponentExecution
diff --git a/leanncd/experiments/indexed_execution/IndexedComponentExecutionTransport.lean b/leanncd/experiments/indexed_execution/IndexedComponentExecutionTransport.lean
new file mode 100644
index 00000000..b5575530
--- /dev/null
+++ b/leanncd/experiments/indexed_execution/IndexedComponentExecutionTransport.lean
@@ -0,0 +1,151 @@
+import IndexedComponentComposition
+import IndexedComponentTransportEval
+
+namespace IndexedComponentExecution
+
+open LeanNCD.Semantics
+open LeanNCD.Semantics.Program
+open IndexedOpenComposition
+open IndexedComponentTransport
+open IndexedComponentComposition
+
+variable {src dst : Declarations Unit}
+
+def mapLedger (rename : Nat → Nat) (rows : List (Nat × ℚ)) : List (Nat × ℚ) :=
+  rows.map fun row => (rename row.1, row.2)
+
+def mapEvent (f : Embedding src dst) (rename : Nat → Nat) : Event src → Event dst
+  | .produced tag cap value => .produced (rename tag) (rename cap) value
+  | .sealed a value => .sealed (f.address a) value
+  | .undefined tag => .undefined (rename tag)
+
+structure Projection (f : Embedding src dst) (rename : Nat → Nat)
+    (ledgerPrefix : List (Nat × ℚ)) (source : State src) (target : State dst) : Prop where
+  available : ∀ a, target.available (f.address a) = source.available a
+  produced : target.produced = ledgerPrefix ++ mapLedger rename source.produced
+
+theorem producedValue_projection (f : Embedding src dst) (rename : Nat → Nat)
+    (injective : Function.Injective rename) (ledgerPrefix : List (Nat × ℚ))
+    (outside : ∀ row ∈ ledgerPrefix, ∀ cap, row.1 ≠ rename cap)
+    {source : State src} {target : State dst}
+    (related : Projection f rename ledgerPrefix source target)
+    (cap : Nat) :
+    producedValue target (rename cap) = producedValue source cap := by
+  unfold producedValue
+  rw [related.produced, List.find?_append]
+  have hp : ledgerPrefix.find? (fun row => row.1 == rename cap) = none := by
+    apply List.find?_eq_none.mpr
+    intro row hr
+    simpa using outside row hr cap
+  rw [hp]
+  have hm : (mapLedger rename source.produced).find?
+      (fun row => row.1 == rename cap) =
+      (source.produced.find? (fun row => row.1 == cap)).map
+        (fun row => (rename row.1, row.2)) := by
+    induction source.produced with
+    | nil => rfl
+    | cons row rows ih =>
+        by_cases h : row.1 = cap
+        · simp [mapLedger, List.find?, h]
+        · have hn := injective.ne h
+          have hb : (row.1 == cap) = false :=
+            Bool.eq_false_iff.mpr (fun ht => h (beq_iff_eq.mp ht))
+          have hbn : (rename row.1 == rename cap) = false :=
+            Bool.eq_false_iff.mpr (fun ht => hn (beq_iff_eq.mp ht))
+          simpa only [mapLedger, List.map_cons, List.find?_cons, hbn,
+            hb, ↓reduceIte] using ih
+  rw [hm]
+  cases source.produced.find? (fun row => row.1 == cap) <;> rfl
+
+theorem enabled_projection (f : Embedding src dst) (rename : Nat → Nat)
+    (injective : Function.Injective rename) (ledgerPrefix : List (Nat × ℚ))
+    (outside : ∀ row ∈ ledgerPrefix, ∀ cap, row.1 ≠ rename cap)
+    {source : State src} {target : State dst}
+    (related : Projection f rename ledgerPrefix source target)
+    (step : Step src) :
+    enabled target (mapStep f rename step) = enabled source step := by
+  have hp := producedValue_projection f rename injective ledgerPrefix outside related
+  cases step with
+  | write w =>
+      simp [mapStep, mapWriter, enabled, hp, List.all_map, related.available,
+        Function.comp_def]
+  | collect a caps =>
+      simp [mapStep, enabled, hp, List.all_map, related.available, Function.comp_def]
+
+theorem complete_projection (f : Embedding src dst) (rename : Nat → Nat)
+    (injective : Function.Injective rename) (ledgerPrefix : List (Nat × ℚ))
+    (outside : ∀ row ∈ ledgerPrefix, ∀ cap, row.1 ≠ rename cap)
+    {source : State src} {target : State dst}
+    (related : Projection f rename ledgerPrefix source target)
+    (steps : List (Step src)) :
+    complete (steps.map (mapStep f rename)) target = complete steps source := by
+  have hp := producedValue_projection f rename injective ledgerPrefix outside related
+  simp only [complete, List.all_map]
+  apply congrArg (fun predicate : Step src → Bool => steps.all predicate)
+  funext step
+  cases step <;> simp [mapStep, mapWriter, Function.comp_def, hp, related.available]
+
+theorem evalReady_projection (f : Embedding src dst) (rename : Nat → Nat)
+    (ledgerPrefix : List (Nat × ℚ)) {source : State src} {target : State dst}
+    (related : Projection f rename ledgerPrefix source target) (w : Writer src) :
+    evalReady RationalReference.ops target.available (mapWriter f rename w).body () =
+      evalReady RationalReference.ops source.available w.body () := by
+  rw [mapWriter, evalReady_transport]
+  have he : f.pull target.available = source.available := funext related.available
+  rw [he]
+
+theorem selected_projection (f : Embedding src dst) (rename : Nat → Nat)
+    (injective : Function.Injective rename) (ledgerPrefix : List (Nat × ℚ))
+    (outside : ∀ row ∈ ledgerPrefix, ∀ cap, row.1 ≠ rename cap)
+    {source : State src} {target : State dst}
+    (related : Projection f rename ledgerPrefix source target)
+    (steps : List (Step src)) (suffix : List (Step dst)) (step : Step src)
+    (selected : steps.find? (enabled source) = some step) :
+    (steps.map (mapStep f rename) ++ suffix).find? (enabled target) =
+      some (mapStep f rename step) := by
+  have he : enabled target ∘ mapStep f rename = enabled source :=
+    funext (enabled_projection f rename injective ledgerPrefix outside related)
+  simp [List.find?_append, List.find?_map, he, selected]
+
+theorem collector_values_projection (f : Embedding src dst) (rename : Nat → Nat)
+    (injective : Function.Injective rename) (ledgerPrefix : List (Nat × ℚ))
+    (outside : ∀ row ∈ ledgerPrefix, ∀ cap, row.1 ≠ rename cap)
+    {source : State src} {target : State dst}
+    (related : Projection f rename ledgerPrefix source target) (caps : List Nat) :
+    (caps.map rename).mapM (producedValue target) =
+      caps.mapM (producedValue source) := by
+  induction caps with
+  | nil => rfl
+  | cons cap caps ih =>
+      simp [producedValue_projection f rename injective ledgerPrefix outside related, ih]
+
+theorem projection_produce (f : Embedding src dst) (rename : Nat → Nat)
+    (ledgerPrefix : List (Nat × ℚ)) {source : State src} {target : State dst}
+    (related : Projection f rename ledgerPrefix source target) (cap : Nat) (value : ℚ) :
+    Projection f rename ledgerPrefix
+      { source with produced := source.produced ++ [(cap, value)] }
+      { target with produced := target.produced ++ [(rename cap, value)] } := by
+  refine ⟨related.available, ?_⟩
+  simp [related.produced, mapLedger, List.map_append, List.append_assoc]
+
+variable [DecidableEq src.Tensor] [DecidableEq dst.Tensor]
+
+theorem projection_collect (f : Embedding src dst) (rename : Nat → Nat)
+    (ledgerPrefix : List (Nat × ℚ)) {source : State src} {target : State dst}
+    (related : Projection f rename ledgerPrefix source target) (a : Address src) (value : ℚ) :
+    letI := Executor.addressEq (σ := src)
+    letI := Executor.addressEq (σ := dst)
+    Projection f rename ledgerPrefix
+      { source with available := Function.update source.available a (some value) }
+      { target with available := Function.update target.available (f.address a) (some value) } := by
+  letI := Executor.addressEq (σ := src)
+  letI := Executor.addressEq (σ := dst)
+  refine ⟨?_, related.produced⟩
+  intro b
+  by_cases h : b = a
+  · subst b
+    simp
+  · have hn := f.address_injective.ne h
+    simp [Function.update_apply, h, hn, related.available]
+
+end IndexedComponentExecution
diff --git a/leanncd/experiments/indexed_execution/IndexedComponentExecutionPhase.lean b/leanncd/experiments/indexed_execution/IndexedComponentExecutionPhase.lean
new file mode 100644
index 00000000..e3be1237
--- /dev/null
+++ b/leanncd/experiments/indexed_execution/IndexedComponentExecutionPhase.lean
@@ -0,0 +1,91 @@
+import IndexedComponentComposition
+import IndexedComponentModelInputs
+
+namespace IndexedComponentExecution
+
+open LeanNCD.Semantics
+open LeanNCD.Semantics.Program
+open IndexedOpenComposition
+open IndexedComponentTransport
+open IndexedComponentComposition
+
+variable {σA σB : Declarations Unit}
+variable [Fintype σA.Tensor] [DecidableEq σA.Tensor]
+variable [Fintype σB.Tensor] [DecidableEq σB.Tensor]
+variable (A : MatchedComponent σA) (B : MatchedComponent σB) (wire : Boundary A B)
+
+structure UpstreamState (source : State σA) (target : State (declarations A B)) : Prop where
+  available : ∀ a, target.available ((upstream A B).address a) = source.available a
+  downstream : ∀ a : Address σB, B.program.input a.1 = false →
+    target.available ((downstream A B wire).address a) = none
+  produced : target.produced = source.produced.map (fun row => (upstreamId row.1, row.2))
+
+structure DownstreamState (completed : State σA) (source : State σB)
+    (target : State (declarations A B)) : Prop where
+  upstream : ∀ a, target.available ((upstream A B).address a) = completed.available a
+  available : ∀ a, target.available ((downstream A B wire).address a) = source.available a
+  produced : target.produced =
+    completed.produced.map (fun row => (upstreamId row.1, row.2)) ++
+      source.produced.map (fun row => (downstreamId row.1, row.2))
+
+theorem initial_upstream (η : A.program.Input) :
+    UpstreamState A B wire (initial η.val)
+      (initial (liftInput A B wire η).val) := by
+  refine ⟨?_, ?_, rfl⟩
+  · intro a
+    rfl
+  · intro a ha
+    rcases a with ⟨t, p⟩
+    change B.program.input t = false at ha
+    have hnone : (liftInput A B wire η).val ((downstream A B wire).tensor t) = none := by
+      change (liftInput A B wire η).val (downstreamTensor A B wire t) = none
+      rw [downstreamTensor_defined A B wire ⟨t, ha⟩]
+      rfl
+    change Option.map _ ((liftInput A B wire η).val
+      ((downstream A B wire).tensor t)) = none
+    rw [hnone]
+    rfl
+
+theorem graph_steps_standalone :
+    (compose A B wire).graph.steps =
+      A.graph.steps.map (mapStep (upstream A B) upstreamId) ++
+        B.graph.steps.map (mapStep (downstream A B wire) downstreamId) := by
+  change (graph A B wire).steps = _
+  rw [graph_steps, (close_success_canonical A.matched.close_ok).2,
+    (close_success_canonical B.matched.close_ok).2]
+
+theorem boundary_available {completed : State σA} {target : State (declarations A B)}
+    (related : UpstreamState A B wire completed target)
+    (ρA : Store RationalReference.Carrier σA)
+    (full : ∀ a, completed.available a = some (ρA a)) (a : Address σB) :
+    target.available ((downstream A B wire).address a) =
+      (initial (boundaryInput A B wire ρA).val).available a := by
+  rcases a with ⟨t, p⟩
+  by_cases ht : B.program.input t = true
+  · rw [downstream_input_address A B wire ⟨t, ht⟩ p, related.available, full]
+    simp [IndexedOpenComposition.initial, boundaryInput, ht]
+  · have hf : B.program.input t = false := Bool.eq_false_iff.mpr ht
+    rw [related.downstream ⟨t, p⟩ hf]
+    simp [IndexedOpenComposition.initial, boundaryInput, ht]
+
+theorem downstream_at_cut {completed : State σA} {target : State (declarations A B)}
+    (related : UpstreamState A B wire completed target)
+    (ρA : Store RationalReference.Carrier σA)
+    (full : ∀ a, completed.available a = some (ρA a)) :
+    DownstreamState A B wire completed
+      (initial (boundaryInput A B wire ρA).val) target := by
+  refine ⟨related.available, boundary_available A B wire related ρA full, ?_⟩
+  simpa [IndexedOpenComposition.initial] using related.produced
+
+theorem boundary_input_presence (ρA : Store RationalReference.Carrier σA) (t : σB.Tensor) :
+    ((boundaryInput A B wire ρA).val t).isSome = B.program.input t :=
+  (boundaryInput A B wire ρA).property t
+
+theorem boundary_input_exact (ρA : Store RationalReference.Carrier σA)
+    (t : σB.Tensor) (ht : B.program.input t = true) :
+    (boundaryInput A B wire ρA).val t =
+      some (fun p => ρA
+        ⟨(wire.matched ⟨t, ht⟩).val, (wire.domain ⟨t, ht⟩).coord p⟩) := by
+  simp [boundaryInput, ht]
+
+end IndexedComponentExecution
