+  (occurrenceViews zeroContraction).toOption ==
+    some [(0, 0, [0], some 0, 0), (0, 1, [1], some 0, 0),
+      (1, 0, [0], some (2 / 3), 2 / 3), (1, 1, [1], some (5 / 7), 5 / 7)] &&
+  ((admitSource zeroContraction).toOption.map fun source =>
