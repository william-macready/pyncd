+set_option synthInstance.maxSize 1024 in
+#guard B4 = some (B4_expectedTerms, B4_expectedFibers,
+  B4_expectedTerms, B4_expectedFibers, [(7, 2), (3, 3), (11, 0), (19, 4)])
