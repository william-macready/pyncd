+namespace SourceDiagnosticFixtures
+
+def vectorSnapshot : SourceSnapshot :=
+  ⟨⟨[.axis i (some 2), .axis k (some 3), .axis e (some 0),
+      .typedTensor .f64 "A" [i, k], .typedTensor .f64 "B" [i],
+      .typedTensor .f64 "Y" [i], .typedTensor .f64 "Empty" [e],
