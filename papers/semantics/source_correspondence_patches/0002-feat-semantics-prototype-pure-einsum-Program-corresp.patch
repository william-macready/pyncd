+import LeanNCD.Semantics.Source.Statement
+
+namespace LeanNCD.Semantics.Source
+
+structure RawRead (σ : Declarations Unit) where
+  tensor : σ.Tensor
+  indices : List UID
+
+variable {σ : Declarations Unit}
+
+def admitRead (ctx : Shape) (read : RawRead σ) : Except Diagnostic (Read ctx σ) := do
+  let slots ← resolveSlots ctx (σ.signature read.tensor).axes read.indices
+  pure ⟨read.tensor, slots⟩
+
+def admitTerm (out bound : Shape) (reads : List (RawRead σ)) :
+    Except Diagnostic (Term out σ) := do
+  let context ← checkContext (out ++ bound)
+  let support := reads.flatMap RawRead.indices
+  for a in bound do
+    unless a.uid ∈ support do throw (.unusedBinder a.uid)
+  let admitted ← reads.mapM (admitRead (out ++ bound))
+  pure ⟨bound, context.val, context.property, admitted⟩
+
+def admitOutput (dst : σ.Tensor) (out : Shape) (indices : List UID) :
+    Except Diagnostic (Slots out (σ.signature dst).axes) := do
+  let _ ← checkContext out
+  unless indices.toFinset = (out.map Axis.uid).toFinset do throw .outputContext
+  resolveSlots out (σ.signature dst).axes indices
+
+def admitPure (dst : σ.Tensor) (out bound : Shape) (indices : List UID)
+    (reads : List (RawRead σ)) :
+    Except Diagnostic (Slots out (σ.signature dst).axes × Term out σ) := do
+  let slots ← admitOutput dst out indices
+  if reads.isEmpty then throw .emptyOperands
+  let support := reads.flatMap RawRead.indices
+  for uid in indices do
+    unless uid ∈ support do throw (.outputOnly uid)
+  let term ← admitTerm out bound reads
+  pure (slots, term)
+
+end LeanNCD.Semantics.Source
