+  apply interpret_reduce_sum ops store rfl rfl
+  intro i
+  rfl
+
+theorem empty_reduction_exact_without_body :
+    interpret ops store emptyReduction () = some (∑ i : Fin 0, (Fin.elim0 i : ℚ)) := by
