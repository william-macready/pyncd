+def admitSourceSorted (snapshot : SourceSnapshot)
+    (table : List Oracle.Sorted := Oracle.standardCarriers) :
+    Except SourceDiagnostic (AdmittedSource × Oracle.Sorted) :=
+  match admitSourceAffine snapshot (sorted := true) with
+  | .error e => .error e
+  | .ok admitted =>
