diff --git a/leanncd/LeanNCD/Semantics/Plan/Step.lean b/leanncd/LeanNCD/Semantics/Plan/Step.lean
index fbafeff24143c7089d8ba313119b054114606602..3a118e15e7a5c3db0fda7055077f1df09bce7213 100644
--- a/leanncd/LeanNCD/Semantics/Plan/Step.lean
+++ b/leanncd/LeanNCD/Semantics/Plan/Step.lean
@@ -133,10 +133,42 @@ def execAnn (pc : Nat) (M : Memory K σ) : Ann P → StepResult P
   | .acc G => π.execAcc ops pc G M
   | .pub B => execPub B M
 
-/-- Slice 1 executes singleton commands only; anything else is stuck. -/
-def stepCommand (pc : Nat) (M : Memory K σ) : Command P → StepResult P
-  | [a] => π.execAnn ops pc M a
-  | _ => .stuck
+/-- Run a list of annotations from position `n` on the running memory.
+    `semFail`/`stuck` propagate; the caller reports the pre-command memory. -/
+def execAnns (n : Nat) (M : Memory K σ) : List (Ann P) → StepResult P
+  | [] => .ok M
+  | a :: as =>
+    match π.execAnn ops n M a with
+    | .ok M' => execAnns n.succ M' as
+    | res => res
+
+/-- A (possibly fused) command at command position `pc`: its annotations run at the
+    expanded positions `offset pc, offset pc + 1, …` of `π.expand` (spec 29.3), each on
+    the memory left by the previous one. Failure is transactional per command: the
+    callers (`runFrom`) report the pre-command memory. -/
+def stepCommand (pc : Nat) (M : Memory K σ) (cmd : Command P) : StepResult P :=
+  π.expand.execAnns ops (π.offset pc) M cmd
+
+/-- `execAnn` depends on the plan only through the annotation prefix at its position
+    (it reads `readPub pc`, i.e. `Pub pc`, i.e. `prefixAnn pc`). -/
+theorem execAnn_prefix {π π' : P.Plan} {pc pc' : Nat} (h : π.prefixAnn pc = π'.prefixAnn pc')
+    (M : Memory K σ) (a : Ann P) : π.execAnn ops pc M a = π'.execAnn ops pc' M a := by
+  have hr : π.readPub pc = π'.readPub pc' := by
+    funext M a
+    have hp : π.Pub pc a ↔ π'.Pub pc' a := by simp [Pub, pubList, h]
+    unfold readPub
+    by_cases hπ : π.Pub pc a
+    · rw [if_pos hπ, if_pos (hp.mp hπ)]
+    · rw [if_neg hπ, if_neg (fun h' => hπ (hp.mpr h'))]
+  cases a <;> simp [execAnn, execAcc, hr]
+
+/-- On a singleton command the generalised step is the slice-1 step, for ANY plan:
+    this is what keeps the slice-1 step lemmas' statements unchanged. -/
+theorem stepCommand_single (pc : Nat) (M : Memory K σ) (a : Ann P) :
+    π.stepCommand ops pc M [a] = π.execAnn ops pc M a := by
+  have h := execAnn_prefix ops (π.prefixAnn_eq_expand pc).symm M a
+  simp only [stepCommand, execAnns, h]
+  cases π.execAnn ops pc M a <;> rfl
 
 def stepPlan (pc : Nat) (M : Memory K σ) : StepResult P :=
   match π.commands[pc]? with
diff --git a/leanncd/LeanNCD/Semantics/Plan/Syntax.lean b/leanncd/LeanNCD/Semantics/Plan/Syntax.lean
index a281020528d3ba698493a957cfea0320a63273ea..af03ec0aaa584f293478da59a20e503e480d07f3 100644
--- a/leanncd/LeanNCD/Semantics/Plan/Syntax.lean
+++ b/leanncd/LeanNCD/Semantics/Plan/Syntax.lean
@@ -131,6 +131,45 @@ end Decidable
 
 theorem prefixAnn_zero : π.prefixAnn 0 = [] := by simp [prefixAnn]
 
+/-! ### Expansion (spec 29.3): the schedule of a fused plan -/
+
+/-- The expanded plan: every annotation of `π` in its own command. -/
+def expand : P.Plan := { π with commands := π.ann.map (fun a => [a]) }
+
+/-- Number of annotations in the first `pc` commands (the expanded position of command `pc`). -/
+def offset (pc : Nat) : Nat := (π.prefixAnn pc).length
+
+theorem flatten_map_single {α : Type _} (l : List α) : (l.map fun a => [a]).flatten = l := by
+  induction l <;> simp [*]
+
+theorem expand_ann : π.expand.ann = π.ann := flatten_map_single π.ann
+
+theorem expand_prefixAnn (n : Nat) : π.expand.prefixAnn n = π.ann.take n := by
+  show (List.take n (π.ann.map fun a => [a])).flatten = _
+  rw [← List.map_take, flatten_map_single]
+
+theorem expand_commands_getElem? {n : Nat} {a : Ann P} (h : π.ann[n]? = some a) :
+    π.expand.commands[n]? = some [a] := by
+  simp [expand, h]
+
+theorem ann_eq_append (pc : Nat) : π.ann = π.prefixAnn pc ++ (π.commands.drop pc).flatten := by
+  simp only [ann, prefixAnn, ← List.flatten_append, List.take_append_drop]
+
+theorem prefixAnn_eq_expand (pc : Nat) : π.prefixAnn pc = π.expand.prefixAnn (π.offset pc) := by
+  rw [expand_prefixAnn, offset, ann_eq_append π pc, List.take_left' rfl]
+
+theorem drop_flatten {pc : Nat} {cmd : Command P} (h : π.commands[pc]? = some cmd) :
+    (π.commands.drop pc).flatten = cmd ++ (π.commands.drop (pc + 1)).flatten := by
+  obtain ⟨hpc, hc⟩ := List.getElem?_eq_some_iff.mp h
+  rw [List.drop_eq_getElem_cons hpc, hc, List.flatten_cons]
+
+theorem ann_getElem?_offset {pc : Nat} {cmd : Command P} (h : π.commands[pc]? = some cmd)
+    {j : Nat} {a : Ann P} (hj : cmd[j]? = some a) : π.ann[π.offset pc + j]? = some a := by
+  have hlt : j < cmd.length := (List.getElem?_eq_some_iff.mp hj).1
+  rw [ann_eq_append π pc, drop_flatten π h, offset, List.getElem?_append_right (by omega)]
+  simp only [Nat.add_sub_cancel_left]
+  rw [List.getElem?_append_left hlt, hj]
+
 theorem not_cons_zero (x : OccRef P) : ¬ π.Cons 0 x := by
   simp [Cons, consList, prefixAnn_zero]
 
