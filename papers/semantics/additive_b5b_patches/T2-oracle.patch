     | .error e => some e
     | .ok bs =>
       let expected := bs.mapM (predictedExtent · sizes)
-      if ws.any (fun w => (slotsOf w).mapM (predictedExtent · sizes) != expected)
-      then some ("writerExtentMismatch", n) else none
+      if pinnedBox decls n then
+        let fits (w : Stmt) : Bool :=
