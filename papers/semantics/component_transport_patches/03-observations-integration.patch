+    evalReady RationalReference.ops (embed.pull available)
+      (transport (Embedding.id src) precompose contextExpr) () = .evaluated (some 18)))
+#eval check "transport.composition-context-observations" (decide
+  (addresses (footprint (transport back id (transport embed precompose contextExpr)) ()) =
+      addresses (footprint (transport (embed.comp back) precompose contextExpr) ()) ∧
+    evalReady RationalReference.ops available (transport back id (transport embed precompose contextExpr)) () =
+      .evaluated (some 28) ∧
+    evalReady RationalReference.ops available (transport (embed.comp back) precompose contextExpr) () =
+      .evaluated (some 28)))
+
+end IndexedComponentTransportTest
