   | .ok _    => false
 
+-- S3b T8: the SAME law on the tropical grid shapes with an UNWRITTEN state cell (`G[0,1]`, written by
+-- neither the base nor the step). The legacy evaluator starts a tropical state at `0_K` of its sort
+-- (-inf under max, +inf under min); the independent unrolling must therefore fill unreached
+-- coordinates with the state's own `0_K` and merge base contributions with the state's own `⊕`.
+-- The unrolling derives that sort from the statements' annotations (`ScanUnroll.localStateAgg`), not
+-- from production's `scanStateAlgebra`, so agreement is not circular.
+#guard tropicalUnwrittenScanCases.length == 2
+#guard (tropicalUnwrittenScanCases.findSome? checkScanLaw).isNone
+-- TEST-THE-TESTER: the shape really has an unwritten cell that only the state's `0_K` can fill
+-- (a real-zero leaf gave `[2, 0, 5, 5]` / `[-2, 0, -5, -5]` here before the fix).
+#guard (tropicalUnwrittenScanCases.map (fun c => match schedOfCase c with
+  | .ok s => (evalScheduledF64 s c.inputs).toOption.bind (fun r => r.env["G"]?) |>.map (·.data)
+  | .error _ => none)) ==
+  [some #[2.0, -1.0 / 0.0, 5.0, 5.0], some #[-2.0, 1.0 / 0.0, -5.0, -5.0]]
+
 end LeanNCD.PropertyOracle
diff --git a/leanncd/test/Eval/PropertyOracle/ScanUnroll.lean b/leanncd/test/Eval/PropertyOracle/ScanUnroll.lean
index 27257f8a..3ca774b3 100644
--- a/leanncd/test/Eval/PropertyOracle/ScanUnroll.lean
+++ b/leanncd/test/Eval/PropertyOracle/ScanUnroll.lean
@@ -707,6 +707,35 @@ structure MergePart where
   axes       : List AxisSpec
   expected   : List Nat
 
+/-- Sort-neutral writer, restated test-side (one term, one read factor, every read axis on the LHS):
+    such a statement has nothing to combine and so says nothing about its state's sort. -/
+private def localNeutral (s : Stmt) : Bool :=
+  match s with
+  | .assign _ ls r | .scatter _ ls r =>
+      match r.body.terms with
+      | [t] =>
+          match t.factors with
+          | [f] =>
+              match f.read? with
+              | some (_, es) =>
+                  let lhs := ls.flatMap LHSSlot.axisUids
+                  es.all (fun e => (idxAffineForm e).2.all (fun p => lhs.contains p.2))
+              | none => false
+          | _ => false
+      | _ => false
+  | .recurMorphism _ _ _ => false
+
+/-- The aggregation (hence the semiring) the independent unrolling gives state `nm`'s zero leaf and
+    base merge (S3b T8): the annotation its first NON-neutral statement carries, `sum` (real) if every
+    statement is neutral. Derived here from the statements alone. It deliberately calls neither
+    `scanStateAlgebra`/`scanStateSorts` nor any production state-init helper, so that agreement with
+    the production scan worker's `0_K` start is a real check and not production compared with itself. -/
+def localStateAgg (g : ScanGeom) (nm : String) : AggOp :=
+  let own := (g.base ++ g.recur).filter (fun s => s.lhsName == nm && !localNeutral s)
+  match own.head? with
+  | some (.assign _ _ r) | some (.scatter _ _ r) => r.agg
+  | _ => .sum
+
