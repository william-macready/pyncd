+  out := out ++ [← rawFixture "max_empty_output" #[⟨#[0], .f64⟩]
+    { empty with outputShape := #[0], terms := #[{ contextPos := #[], iterationShape := #[0], outputPos := #[0], reductionPos := #[], factors := #[] }] } #[]]
+  return out
