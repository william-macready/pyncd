+def contextProg : TLProgram := tlprog!{
+  axis i : ℕ = 2
+  iter t = 4
+  tensor f64 X(i), Y(t, i), S(i, t)
+  S[i, 0] := X[i]
+  S[i, t +1] := maxreduce(Y[t, i])
+}
