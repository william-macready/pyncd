+def BareOutputSlots (slots : List LHSSlot) (ids : List UID) : Prop :=
+  List.Forall₂ (fun (s, _) uid => ∃ a : AxisSpec, s = .free a ∧ uid = a.uid)
+    slots.zipIdx ids
