+def BareReadSlots (es : List IdxExpr) (ids : List UID) : Prop :=
+  List.Forall₂ (fun (e, _) uid => ∃ a : AxisSpec, e = .axis a ∧ uid = a.uid)
+    es.zipIdx ids
