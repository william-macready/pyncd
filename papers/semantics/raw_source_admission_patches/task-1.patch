+theorem resolveSource_mapUID (raw : TLProgram) (specs : List TensorSpec)
+    (inputs : List InputBinding) (snapshot : SourceSnapshot)
+    (h : resolveSource raw specs inputs = .ok snapshot) :
+    ∃ memo : Std.HashMap String UID,
